{
  "tasks": {
    "start": "deno run --env-file --allow-net --allow-env --allow-read --allow-write --allow-ffi --allow-sys --allow-run index.ts"
  },
  "imports": {
    "@gradylink/unb": "jsr:@gradylink/unb@0.8.1",
    "groq-sdk": "npm:groq-sdk@^1.2.0",
    "groq-sdk/resources/chat.mjs": "npm:groq-sdk@^1.2.0/resources/chat.mjs",
    "node-llama-cpp": "npm:node-llama-cpp@^3.18.1"
  },
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "nodeModulesDir": "auto"
}
